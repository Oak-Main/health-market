{
  "name": "subsidy-dropoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subsidy Dropoff - find the income at which your ACA premium tax credit disappears",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "engine:build": "tsc -p tsconfig.engine.json",
    "engine:typecheck": "tsc -p tsconfig.engine.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "etl": "tsx src/etl/run.ts",
    "etl:verify": "tsx src/etl/verify.ts",
    "dev:engine": "tsx src/dev-server.ts",
    "check:security-floor": "node scripts/check-security-floor.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "^16.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  }
}
